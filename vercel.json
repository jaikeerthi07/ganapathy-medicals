{
  "version": 2,
  "builds": [
    {
      "src": "InventoryManagementFE/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/InventoryManagementFE/static/$1"
    },
    {
      "source": "/([^/]+\\.(?:png|jpg|jpeg|gif|ico|json|txt|js|css))",
      "destination": "/InventoryManagementFE/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/InventoryManagementFE/index.html"
    }
  ]
}
